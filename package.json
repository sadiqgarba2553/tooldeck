{
  "name": "bluecloud-tooldeck",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local PDF, image, video, audio, conversion and utility tools by BlueCloud",
  "author": "BLUECLOUD",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/copy-runtime.mjs",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.mjs",
    "setup:native": "node scripts/setup-native.mjs",
    "test:desktop": "node scripts/smoke-desktop.cjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "diff": "9.0.0",
    "docx": "9.12.0",
    "exceljs": "4.4.0",
    "ffmpeg-static": "5.3.0",
    "jszip": "3.10.2",
    "marked": "18.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "terser": "5.51.2",
    "tesseract.js": "7.0.0",
    "upng-js": "2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "vite": "8.1.3"
  },
  "build": {
    "appId": "com.bluecloud.tooldeck",
    "productName": "Tooldeck",
    "electronVersion": "44.9.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "THIRD_PARTY.md",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/tooldeck.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tooldeck-Setup-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "native/qpdf-bin",
        "to": "native/qpdf-bin"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "native/ffmpeg.exe"
      }
    ]
  },
  "overrides": {
    "image-size": "2.0.4",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
